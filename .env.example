# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# New prescription requests: approved Meta template WITHOUT body parameters.
# Empty number disables these alerts. Use international format.
SECRETARY_WHATSAPP_NUMBER=""
SECRETARY_WHATSAPP_TEMPLATE="nueva_solicitud_receta"
SECRETARY_WHATSAPP_TEMPLATE_LANGUAGE="es_AR"

# MERCADO PAGO OFFICIAL INTEGRATION
MP_ACCESS_TOKEN="APP_USR-your-access-token"
MP_PUBLIC_KEY="APP_USR-your-public-key"
MP_WEBHOOK_SECRET="your-mercado-pago-webhook-secret"
WEBHOOK_URL="https://your-public-domain.com"
CRON_SECRET="generate-a-random-secret-with-at-least-16-characters"

# ERROR NOTIFICATIONS & SMTP CONFIGURATION
ADMIN_EMAIL="santi.olaciregui13@gmail.com"
ENABLE_ERROR_ALERTS="true"
ERROR_ALERT_THROTTLE_MINUTES="10"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="notificaciones@mireceta.com"
SMTP_PASS="your-app-password"

# DATABASE
# Use the production connection string supplied by your MongoDB provider.
# Do not commit credentials. Configure the real value in Vercel environment variables.
MONGODB_URI="mongodb://username:password@host:27017/mi-receta?authSource=admin"

# US-015: First-party analytics. Disabled by default; no historical backfill.
ANALYTICS_ENABLED="false"
VITE_ANALYTICS_ENABLED="false"
ANALYTICS_ENVIRONMENT="development"
# Exact origins mapped to verified tenant IDs. Never use a wildcard.
ANALYTICS_HOSTS='{"http://localhost:3000":"TEN-0001"}'
ANALYTICS_STARTED_AT=""
# Explicit JWT_SECRET of at least 32 characters is required for analytics.
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
ANALYTICS_TEST_USER_IDS=""
